{
  "root": true,
  "parser": "@typescript-eslint/parser",
  "parserOptions": {
    "ecmaVersion": "latest",
    "sourceType": "module"
  },
  "plugins": ["@typescript-eslint", "react-hooks"],
  "extends": [
    "eslint:recommended",
    "plugin:@typescript-eslint/recommended",
    "plugin:react-hooks/recommended"
  ],
  "rules": {
    "no-console": "error"
  },
  "ignorePatterns": [
    ".next/**/*",
    "app/**/*",
    "dist/**/*",
    "node_modules/**/*",
    "test/compat/**/*"
  ]
}
