{
  "name": "safe-form",
  "version": "0.11.2",
  "description": "⚡️ End-to-end type-safety from client to server.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "test": "vitest",
    "test:compat": "npm run build && npm run test:compat:types && npm run test:compat:frameworks",
    "test:compat:types": "tsc -p test/compat/next/tsconfig.json && tsc -p test/compat/waku/tsconfig.json && tsc -p test/compat/react-router-vite/tsconfig.json",
    "test:compat:frameworks": "npm run test:compat:next && npm run test:compat:waku && npm run test:compat:react-router-vite",
    "test:compat:next": "next build test/compat/next",
    "test:compat:waku": "cd test/compat/waku && waku build",
    "test:compat:react-router-vite": "react-router build test/compat/react-router-vite",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint ./src",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "check": "biome check ."
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ivanfilhoz/safe-form.git"
  },
  "keywords": [
    "react",
    "safe",
    "form",
    "rsc",
    "standard-schema",
    "hook",
    "validation",
    "server",
    "action",
    "server-functions",
    "framework-agnostic",
    "front-end",
    "back-end"
  ],
  "author": "Ivan Filho",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/ivanfilhoz/safe-form/issues"
  },
  "homepage": "https://github.com/ivanfilhoz/safe-form#readme",
  "devDependencies": {
    "@biomejs/biome": "2.4.16",
    "@react-router/dev": "^7.16.0",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20.11.25",
    "@types/react": "^19.2.16",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "jsdom": "^24.0.0",
    "next": "^16.2.7",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router": "^7.16.0",
    "react-server-dom-webpack": "^19.2.7",
    "typescript": "^5.4.2",
    "vite": "^7.3.5",
    "vitest": "^4.1.8",
    "waku": "^0.27.5",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "react": "^19"
  },
  "dependencies": {
    "@standard-schema/spec": "^1.1.0",
    "superjson": "^2.2.1"
  }
}
