{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "allowJs": false,
    "declaration": true,
    // The published package only ships dist, so declaration maps would point
    // at missing files; inlineSources keeps the source maps self-contained
    "declarationMap": false,
    "emitDeclarationOnly": false,
    "incremental": false,
    "inlineSources": true,
    "noEmit": false,
    "outDir": "./dist",
    "sourceMap": true
  },
  "include": ["src/**/*.ts"],
  "exclude": ["**/*.test.ts", "**/*.test.tsx"]
}
